{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,

    // .ts import specifiers, so `npm run dev` runs the sources directly through
    // Node's --experimental-strip-types with no bundler. Safe with noEmit —
    // nothing here is compiled except by esbuild, which accepts them.
    // The build and version scripts are plain .mjs so they can run under Node
    // with nothing to compile, and test/version.test.ts imports the version
    // rules to test them. allowJs lets tsc infer their types from the source
    // rather than demanding a hand-written .d.mts beside each one; checkJs stays
    // off, so they are read for types and not themselves type-checked.
    "allowJs": true,

    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,

    "noEmit": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "scripts/**/*.mjs"]
}
