{
  "name": "quantitats-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "An MCP server over the published trading API — every /v1 endpoint an API key can reach, as a tool.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "quantitats-mcp": "dist/server.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --experimental-strip-types src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "node scripts/build.mjs",
    "start": "node dist/server.mjs",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
