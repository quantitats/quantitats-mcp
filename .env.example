# The API host, and the only optional one of the three below — leave it out and
# requests go to the hosted API, https://api.quantitats.com.
#
# An origin with no path. Every endpoint already hangs off /v1, so what is
# actually dialled and signed is https://api.quantitats.com/v1/bots and the rest;
# putting /v1 here too would dial /v1/v1/bots. A path here would also put a
# segment in the URL that is not in the string the request is signed over, which
# is why it is refused at startup rather than left to fail as a bad signature.
# QUANTITATS_API_URL=https://api.quantitats.com

# The key id shown when the key was created.
QUANTITATS_API_KEY_ID=ak_klzcmzngbqjnfciylwkq52ebgy

# --- Key material: set ONE of the two pairs below. ---------------------------
#
# Prefer the _FILE form. A private key in an env block is readable by anything
# that can see the process, and lands in whatever launched it.

# Ed25519 — you keep the private key and the server only ever had the public
# half. Nothing on the server side can produce your signature.
# QUANTITATS_API_PRIVATE_KEY_FILE=/run/secrets/api-key.pem
# QUANTITATS_API_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# HMAC-SHA256 — the base64 secret you were shown once. Paste it as shown; it is
# decoded before signing, which this client does for you.
# QUANTITATS_API_SECRET_FILE=/run/secrets/api-secret
# QUANTITATS_API_SECRET=AQIDBAUGBwgJCgsMDQ4PEBESExQVFhcYGRobHB0eHyA=

# Only needed when both kinds of key material are set: "Ed25519" or "HMAC-SHA256".
# QUANTITATS_API_ALG=Ed25519

# --- Optional narrowings -----------------------------------------------------

# Hide every tool that places or cancels an order, or that creates, reconfigures
# or stops a bot. The key's own scopes still bound what is possible; this is a
# second, local answer to "what can this assistant do".
# QUANTITATS_MCP_READ_ONLY=true

# The scopes this key was actually granted. A key's scopes are not readable from
# any endpoint, so stating them here stops tools being advertised that the key
# would only be refused for. Unset advertises everything.
# QUANTITATS_MCP_SCOPES=bots:read,trade:read,portfolio:read

# How long to wait for one request. Default 30000.
# QUANTITATS_API_TIMEOUT_MS=30000
